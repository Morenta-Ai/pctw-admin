# Copy to .env.local and adjust. Never commit real values.

# dev | staging | prod
APP_ENV=dev

# The ReThread .NET API, including the /api/v1 prefix.
API_BASE_URL=http://localhost:5080/api/v1

# true serves everything from the in-memory MockWorld (no backend needed).
USE_MOCK_DATA=true

# Encrypts the session cookie. Required outside dev, 32+ characters.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# Google Maps JavaScript API key for the live map (restrict it to your
# portal's domains). Without it the portal draws its own map of Colombo.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional map ID for advanced markers; Google's DEMO_MAP_ID is used if unset.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
