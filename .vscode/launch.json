{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ReThread Admin (dev, mock data)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "serverReadyAction": {
        "pattern": "- Local:.+(https?://.+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      }
    },
    {
      "name": "Vitest (current file)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm vitest run ${relativeFile}"
    }
  ]
}
